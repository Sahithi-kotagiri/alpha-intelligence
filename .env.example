# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local

# Required by SEC EDGAR fair-access policy: "<Organisation or name> <contact email>"
SEC_USER_AGENT=

# LLM provider: none | anthropic   (needed from Milestone 3)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=

DATABASE_URL=sqlite:///./data/investment_intelligence.db
