# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local

# Required by SEC EDGAR fair-access policy: "<Organisation or name> <contact email>"
SEC_USER_AGENT=

# LLM provider: none | anthropic. Without a key the platform runs in clearly-labelled rule-based mode.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
# Optional: override the Claude API URL (deliberately NOT read from ANTHROPIC_BASE_URL)
# CLAUDE_API_BASE_URL=https://api.anthropic.com

# Optional server-side voice (browser speech is used otherwise): none | openai
VOICE_PROVIDER=none
OPENAI_API_KEY=

# Persistence: SQLite locally; PostgreSQL for deployment
DATABASE_URL=sqlite:///./data/investment_intelligence.db
# POSTGRES_PASSWORD=   # used by docker-compose

# Security: local (single user) | token (register/login, per-user isolation). Use token beyond localhost.
AUTH_MODE=local
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:3000

# Scheduling
SCHEDULER_ENABLED=true
MONITORING_INTERVAL_HOURS=24
PERFORMANCE_INTERVAL_HOURS=24
