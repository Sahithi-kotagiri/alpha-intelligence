# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local

# Required by SEC EDGAR fair-access policy: "<Organisation or name> <contact email>"
SEC_USER_AGENT=

# LLM provider: none | anthropic | openai_compatible
# Without an LLM the platform runs in clearly-labelled rule-based mode (all numbers, scores and decisions still work).
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high

# --- Option A: Anthropic Claude (paid API; best quality)
ANTHROPIC_API_KEY=

# --- Option B: any OpenAI-compatible API (free options). Set LLM_PROVIDER=openai_compatible and ONE of
#     (model names are examples; check the provider's current model list and free-tier limits/terms):
#   Ollama (local, free, private):  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen3:8b   (no key)
#   Google Gemini (free tier):      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash   LLM_API_KEY=...
#   Groq (free tier):               LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile   LLM_API_KEY=...
#   OpenRouter (free models):       LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<a model id ending in :free>   LLM_API_KEY=...
LLM_BASE_URL=
LLM_API_KEY=
# json_schema (default) | json_object | prompt — the client falls back automatically if a provider rejects json_schema
LLM_JSON_MODE=json_schema
# Optional: override the Claude API URL (deliberately NOT read from ANTHROPIC_BASE_URL)
# CLAUDE_API_BASE_URL=https://api.anthropic.com

# Optional server-side voice (browser speech is used otherwise): none | openai
VOICE_PROVIDER=none
OPENAI_API_KEY=

# Persistence: SQLite locally; PostgreSQL for deployment
DATABASE_URL=sqlite:///./data/investment_intelligence.db
# POSTGRES_PASSWORD=   # used by docker-compose

# Security: local (single user) | token (register/login, per-user isolation). Use token beyond localhost.
AUTH_MODE=local
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:3000

# Scheduling
SCHEDULER_ENABLED=true
MONITORING_INTERVAL_HOURS=24
PERFORMANCE_INTERVAL_HOURS=24
